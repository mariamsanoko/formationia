const item = slug ? allItems[slug] : null;

if (!item) {
    return Astro.redirect('/catalog');
}

const metadata = {
    title: item.title,
};
---

<Layout metadata={metadata}>
    <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
        <a href="/catalog" class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-blue-600 hover:text-blue-800 dark:text-blue-400 mb-6 transition">
            ← Retour au catalogue
        </a>

        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl overflow-hidden p-6 sm:p-10 shadow-lg">
            <div class="relative h-64 sm:h-96 w-full overflow-hidden rounded-2xl mb-8">
                <img src={item.image} alt={item.title} class="w-full h-full object-cover" />
                <span class="absolute top-4 left-4 bg-slate-900/80 backdrop-blur-sm text-white text-xs uppercase tracking-wider font-semibold px-3 py-1 rounded-md">
          {item.category}
        </span>
            </div>

            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8 pb-8 border-b border-slate-100 dark:border-slate-800">
                <div>
                    <h1 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white leading-tight">
                        {item.title}
                    </h1>
                    <p class="text-slate-600 dark:text-slate-400 mt-3 text-sm sm:text-base leading-relaxed">
                        {item.description}
                    </p>
                </div>
                <div class="shrink-0 bg-slate-50 dark:bg-slate-800/60 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 text-center md:text-right min-w-[200px]">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 block mb-1">Tarif unique</span>
                    <span class="text-3xl font-black text-slate-900 dark:text-white block mb-4">{item.price}</span>
                    <button
                            type="button"
                            data-price-id={item.priceId}
                            class="stripe-checkout-btn w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-xl shadow-md hover:shadow-lg transition"
                    >
                        Acheter l'accès
                    </button>
                </div>
            </div>

            <div>
                <h2 class="text-xl font-extrabold text-slate-900 dark:text-white mb-4">
                    Ce qui est inclus dans cette ressource :
                </h2>
                <ul class="space-y-3.5">
                    {item.content.map((point: string) => (
                            <li class="flex items-start gap-3 text-sm sm:text-base text-slate-700 dark:text-slate-300">
                                <span class="text-green-500 font-bold mt-0.5">✓</span>
                                <span>{point}</span>
                            </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <script>
        function initSlugCheckout() {
            document.querySelectorAll('.stripe-checkout-btn').forEach((btn) => {
                btn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    const target = e.currentTarget as HTMLButtonElement;
                    const priceId = target.dataset.priceId;
                    if (!priceId) return;

                    const originalText = target.innerText;
                    target.disabled = true;
                    target.innerText = 'Redirection...';

                    try {
                        const res = await fetch('/api/create-checkout-session', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ priceId }),
                        });
                        const data = await res.json();
                        if (data.url) {
                            window.location.href = data.url;
                        } else {
                            alert(`Erreur : ${data.error || 'Impossible d’ouvrir la page de paiement.'}`);
                            target.disabled = false;
                            target.innerText = originalText;
                        }
                    } catch (err) {
                        console.error('Erreur réseau :', err);
                        alert('Une erreur réseau est survenue.');
                        target.disabled = false;
                        target.innerText = originalText;
                    }
                });
            });
        }

        initSlugCheckout();
        document.addEventListener('astro:page-load', initSlugCheckout);
    </script>
</Layout>