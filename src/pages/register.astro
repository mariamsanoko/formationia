---
import Layout from '~/layouts/PageLayout.astro';
import RegisterForm from '~/components/RegisterForm.astro';

const metadata = {
    title: 'Inscription — MS I.A & No Code',
    ignoreTitleTemplate: true,
};
---
<Layout metadata={metadata}>
    <section class="max-w-xl mx-auto px-4 sm:px-6 py-12 lg:py-20">
        <div class="bg-white dark:bg-slate-900 p-8 rounded-lg shadow-md border border-gray-200 dark:border-gray-700">
            <h1 class="text-2xl font-bold mb-6 text-center dark:text-white">Créer un compte</h1>
            <RegisterForm />
        </div>
    </section>
</Layout>